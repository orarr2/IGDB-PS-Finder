# ─────────────────────────────────────────────────────────────────────────────
# Sample environment file. Copy to `.env` and fill in YOUR OWN values.
#   cp .env.example .env
# `.env` is git-ignored — never commit it. These are blanks on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL — Project Settings → Data API.
# Public, non-sensitive.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase ANON / PUBLISHABLE key — Project Settings → API Keys.
# This one is meant to be used by clients (the web app) and by the CI workflows.
# Row-Level Security limits it to read-only, so it is safe to expose — but it's
# still YOUR key, so keep your own value here / in GitHub Actions secrets.
SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — Project Settings → API Keys.
# SECRET. Bypasses Row-Level Security. Used only by load_to_supabase.py for the
# one-time data load. NEVER commit this and never ship it to a client.
SUPABASE_SERVICE_KEY=

# Twitch developer app (used by collect_igdb.py to call the IGDB API).
# Register at https://dev.twitch.tv/console/apps. The secret is SECRET.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
