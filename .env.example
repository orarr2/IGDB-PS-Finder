# Copy to .env and fill in. Do NOT commit .env.
# Get these from Supabase: Project Settings → API Keys.

# Public, non-sensitive
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key — safe to ship in a client, gated by RLS
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Used only by collect_igdb.py — register an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Used only by load_to_supabase.py — service_role key, bypasses RLS, NEVER commit
SUPABASE_SERVICE_KEY=
